<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <StartupHookSupport>false</StartupHookSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableDiagnostics>false</EnableDiagnostics>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RedLotus.ScanHelper</AssemblyName>
    <Product>Red Lotus Scan Helper</Product>
    <Title>Red Lotus Scan Helper</Title>
    <Description>On-demand Microsoft Defender scanning for Red Lotus applications</Description>
    <RootNamespace>NightOps.ScannerHelper</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.StartupHookProvider.IsSupported" Value="false" />
    <RuntimeHostConfigurationOption Include="System.Diagnostics.Debugger.IsSupported" Value="false" />
  </ItemGroup>
</Project>
